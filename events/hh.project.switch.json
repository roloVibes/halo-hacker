{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hh.project.switch event",
  "description": "The active project / bug-bounty program changed. The whole cockpit re-renders for the new program.",
  "type": "object",
  "required": ["program_id"],
  "additionalProperties": false,
  "properties": {
    "program_id": { "type": "string" },
    "program_name": { "type": "string" },
    "platform": { "type": "string", "enum": ["hackerone", "bugcrowd", "intigriti", "custom"] },
    "previous_program_id": { "type": "string" }
  }
}
