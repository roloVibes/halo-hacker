{
  "mcpServers": {
    "ingest": {
      "command": "${halo_python}",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/ingest_server.py"],
      "env": {
        "HALO_HACKER_PACK_ID": "halo-hacker"
      }
    },
    "cve": {
      "command": "${halo_python}",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/cve_server.py"]
    },
    "traffic": {
      "command": "${halo_python}",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/traffic_server.py"],
      "env": {
        "HALO_HACKER_PACK_ID": "halo-hacker"
      }
    },
    "h1": {
      "command": "${halo_python}",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/h1_server.py"],
      "env": {
        "HALO_HACKER_PACK_ID": "halo-hacker"
      }
    }
  }
}
